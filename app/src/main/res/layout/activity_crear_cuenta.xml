<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_login"
    android:fillViewport="true"
    tools:context=".CrearCuenta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="30dp"
        android:paddingTop="20dp"
        android:paddingRight="30dp"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/tvcrear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Crear Cuenta"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/txtrut"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/campo_fondo"
            android:hint="Rut (ej: 11111111-1)"
            android:inputType="text"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textColorHint="#777777"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/txtnom"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:background="@drawable/campo_fondo"
                android:hint="Nombre"
                android:inputType="textPersonName"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textColorHint="#777777"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/txtape"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:background="@drawable/campo_fondo"
                android:hint="Apellido"
                android:inputType="textPersonName"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textColorHint="#777777"
                android:textSize="18sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/txtcorreo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/campo_fondo"
            android:hint="Correo Electrónico"
            android:inputType="textEmailAddress"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textColorHint="#777777"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/spcargo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/campo_fondo"
            android:entries="@array/cargos"
            android:paddingLeft="16dp"
            android:paddingRight="16dp" />

        <EditText
            android:id="@+id/txtcon"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/campo_fondo"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textColorHint="#777777"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/txtcon2"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/campo_fondo"
            android:hint="Repetir Contraseña"
            android:inputType="textPassword"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textColorHint="#777777"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnreg"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/negro_boton"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Registrar"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnvolver"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/rojo_alarma"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Volver"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
